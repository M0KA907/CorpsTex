{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CorpsTex",
  "version": "0.1.7",
  "identifier": "io.github.m0ka907.corpstex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CorpsTex",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Desktop client for installed Codex and OpenCode runtimes",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": { "../LICENSE": "LICENSE", "../NOTICE": "NOTICE", "../src/assets/providers/LICENSE": "PROVIDER-LICENSE" },
    "useLocalToolsDir": true
  }
}
